    "        risk[key] = {\"risk\": round(r[\"risk\"], 2), \"event\": r[\"event\"]}\n",
    "\n",
    "out = os.path.expanduser(\"~/atmograph-ui/public/risk.json\")\n",
    "with open(out, \"w\") as f:\n",
    "    json.dump(risk, f)\n",
    "print(len(risk), \"risky nodes written to\", out)"
