   "source": [
    "LABELS = {\"GPE\", \"LOC\", \"FAC\", \"ORG\"}\n",
    "HIGH = [\"strike\", \"walkout\", \"shutdown\", \"closure\", \"suspend\", \"cyclone\", \"cyber attack\", \"flooding\", \"halted\", \"fire\", \"blockade\"]\n",
    "MEDIUM = [\"congestion\", \"delay\", \"warning\", \"backlog\", \"breakdown\", \"shortage\"]\n",
    "RESOLVED = [\"reopened\", \"called off\", \"no impact\", \"resumed\"]\n",
    "\n",
    "def score(text):\n",
    "    t = text.lower()\n",
    "    if not any(k in t for k in HIGH + MEDIUM):\n",
    "        return 0.0\n",
    "    if any(k in t for k in RESOLVED):\n",
    "        return 0.1\n",
    "    if any(k in t for k in HIGH):\n",
    "        return 0.9\n",
    "    return 0.6\n",
    "\n",
    "events = {}\n",
    "for text in headlines:\n",
    "    risk = score(text)\n",
    "    if risk == 0:\n",
    "        continue\n",
    "    doc = nlp(text)\n",
    "    for ent in doc.ents:\n",
    "        if ent.label_ in LABELS:\n",
    "            for city, code in city_port.items():\n",
    "                if city in ent.text.lower():\n",
    "                    if risk > events.get(code, {}).get(\"risk\", 0):\n",
    "                        events[code] = {\"risk\": risk, \"event\": text}\n",
    "\n",
    "for code, e in events.items():\n",
    "    print(code, port_city[code], e[\"risk\"], \"-\", e[\"event\"])"
   ]
