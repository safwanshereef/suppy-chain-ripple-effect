    "risk = {}\n",
    "with driver.session(database=DATABASE) as session:\n",
    "    result = session.run(\"\"\"\n",
    "        MATCH (n) WHERE n.risk_score IS NOT NULL AND n.risk_score > 0\n",
    "        RETURN n.port_code AS port, n.plant_code AS plant, n.customer_id AS cust,\n",
    "               n.risk_score AS risk, n.last_event AS event\n",
    "    \"\"\")\n",
    "    for r in result:\n",
