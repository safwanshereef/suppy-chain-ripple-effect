    "with driver.session(database=DATABASE) as session:\n",
    "    session.run(\"MATCH (n) WHERE n:Port OR n:Plant OR n:Customer SET n.risk_score = 0.0, n.last_event = null\")\n",
    "\n",
    "    for code, e in events.items():\n",
    "        session.run(\n",
    "            \"MATCH (p:Port {port_code: $c}) SET p.risk_score = $r, p.last_event = $e, p.updated_at = datetime()\",\n",
    "            c=code, r=e[\"risk\"], e=e[\"event\"])\n",
    "\n",
    "    session.run(\"\"\"\n",
    "        MATCH (pl:Plant)-[:HOSTED_AT]->(p:Port) WHERE p.risk_score > 0\n",
    "        WITH pl, max(p.risk_score) AS m\n",
    "        SET pl.risk_score = m * 0.7\n",
    "    \"\"\")\n",
    "\n",
    "    session.run(\"\"\"\n",
    "        MATCH (pl:Plant)-[:ORDERED_BY]->(c:Customer) WHERE pl.risk_score > 0\n",
    "        WITH c, max(pl.risk_score) AS m\n",
    "        SET c.risk_score = m * 0.5\n",
    "    \"\"\")\n",
    "\n",
    "print(\"Risk updated in Neo4j\")"
   ]
